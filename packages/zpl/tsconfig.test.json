{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@zplkit/core",
    "paths": {
      "@zplkit/core/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@zplkit/core/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules/**"]
}
