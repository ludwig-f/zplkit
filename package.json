{
  "name": "zplkit-monorepo",
  "private": true,
  "type": "module",
  "repository": "https://github.com/ludwig-f/zplkit",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "commands": "node scripts/commands.mjs",
    "lint": "eslint packages/*/src apps/site/app apps/site/components apps/site/lib apps/site/playground --ext .ts,.tsx",
    "fix": "prettier \"packages/*/src/**/*.{ts,tsx}\" \"packages/render/scripts/*.mjs\" \"apps/site/{app,components,lib,playground}/**/*.{ts,tsx,css}\" --write",
    "prepare": "husky",
    "format:check": "prettier \"packages/*/src/**/*.{ts,tsx}\" \"packages/render/scripts/*.mjs\" \"apps/site/{app,components,lib,playground}/**/*.{ts,tsx,css}\" --check"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^6.11.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^2.1.1",
    "typescript": "~5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
