{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/zpl": {
      "release-type": "node",
      "package-name": "@zplkit/core",
      "include-component-in-tag": false
    },
    "packages/render": {
      "release-type": "node",
      "package-name": "@zplkit/render",
      "initial-version": "0.1.0"
    },
    "packages/preview": {
      "release-type": "node",
      "package-name": "@zplkit/preview",
      "initial-version": "0.1.0"
    },
    "packages/print": {
      "release-type": "node",
      "package-name": "@zplkit/print",
      "initial-version": "0.1.0"
    },
    "packages/cli": {
      "release-type": "node",
      "package-name": "@zplkit/cli",
      "initial-version": "0.1.0"
    },
    "packages/mcp": {
      "release-type": "node",
      "package-name": "@zplkit/mcp",
      "initial-version": "0.1.0"
    },
    "plugins/zplkit": {
      "release-type": "simple",
      "package-name": "zplkit-plugin",
      "component": "plugin",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
